generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["better_auth", "public"]
}

model devices {
  id                 BigInt               @id @default(autoincrement())
  vendor_id          BigInt
  name               String
  bus                String
  devs_name          String
  product_id         String
  driver_id          BigInt
  support_status     support_type         @default(unknown)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  drivers            drivers              @relation(fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendors            vendors              @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issues             issues[]
  other_device_names other_device_names[]

  @@index([vendor_id, bus, product_id], map: "devices_vendor_id_bus_dev_id_idx")
  @@schema("public")
}

model drivers {
  id         BigInt    @id @default(autoincrement())
  name       String    @unique
  dev_type   String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  devices    devices[]

  @@schema("public")
}

model issues {
  id          BigInt   @id @default(autoincrement())
  dev_id      BigInt
  description String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  devices     devices  @relation(fields: [dev_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model vendors {
  id      BigInt    @id @default(autoincrement())
  name    String?   @default("")
  pci_id  String?
  pcidev  String?
  usb_id  String?
  usbdev  String?
  devices devices[]

  @@index([usb_id])
  @@index([pci_id])
  @@schema("public")
}

model other_device_names {
  id          BigInt   @id @default(autoincrement())
  device_name String   @default("")
  device_id   BigInt
  vendor_name String   @default("")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  devices     devices  @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([device_id])
  @@schema("public")
}

model reports {
  id               BigInt             @id @default(autoincrement())
  user_id          String
  status           report_status      @default(pending)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  withdrawn_at     DateTime?
  withdrawn_note   String?
  reportReviews    report_reviews[]
  sources          report_sources[]
  reported_devices reported_devices[]
  user             User               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model report_sources {
  id               BigInt             @id @default(autoincrement())
  report_id        BigInt
  name             String?
  source_type      source_type
  url              String?
  form_report      form_reports?
  hwinspect_report hwinspect_reports?
  report           reports            @relation(fields: [report_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([report_id])
  @@schema("public")
}

model hwinspect_reports {
  id                BigInt         @id @default(autoincrement())
  report_source_id  BigInt         @unique
  hwinspect_version String
  openbsd_version   String?
  architecture      String?
  collected_at      DateTime?
  payload           Json
  payload_version   Int            @default(1)
  source            report_sources @relation(fields: [report_source_id], references: [id])

  @@schema("public")
}

model form_reports {
  id               BigInt         @id @default(autoincrement())
  report_source_id BigInt         @unique
  url              String
  collected_at     DateTime?
  payload          Json
  payload_version  Int            @default(1)
  source           report_sources @relation(fields: [report_source_id], references: [id])

  @@schema("public")
}

model reported_devices {
  id                          BigInt                        @id @default(autoincrement())
  report_id                   BigInt
  bus                         String
  vendor_id                   String
  product_id                  String
  reported_vendor             String?
  reported_product            String?
  reported_driver             String?
  support_status              support_type
  report                      reports                       @relation(fields: [report_id], references: [id])
  reported_issues             reported_issues[]
  reported_other_device_names reported_other_device_names[]

  @@index([report_id])
  @@schema("public")
}

model reported_issues {
  id                 BigInt           @id @default(autoincrement())
  reported_device_id BigInt
  description        String
  reported_device    reported_devices @relation(fields: [reported_device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reported_device_id])
  @@schema("public")
}

model reported_other_device_names {
  id                        BigInt                        @id @default(autoincrement())
  reported_device_id        BigInt
  vendor_name               String
  product_name              String
  reportedNameVerifications reported_name_verifications[]
  reported_device           reported_devices              @relation(fields: [reported_device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reported_device_id])
  @@schema("public")
}

model report_reviews {
  id           BigInt    @id @default(autoincrement())
  report_id    BigInt
  reviewer_id  String
  created_at   DateTime  @default(now())
  completed_at DateTime?
  notes        String?
  report       reports   @relation(fields: [report_id], references: [id])
  reviewer     User      @relation(fields: [reviewer_id], references: [id])

  @@index([report_id])
  @@index([reviewer_id])
  @@schema("public")
}

model reported_name_verifications {
  id                     BigInt                               @id @default(autoincrement())
  reported_other_name_id BigInt
  search_provider        String                               @default("brave")
  search_query           String
  model                  String
  prompt_version         Int
  created_at             DateTime                             @default(now())
  sources                reported_name_verification_sources[]
  reported_name          reported_other_device_names          @relation(fields: [reported_other_name_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reported_other_name_id])
  @@schema("public")
}

model reported_name_verification_sources {
  id              BigInt                      @id @default(autoincrement())
  verification_id BigInt
  source_id       Int
  url             String
  title           String?
  hostname        String?
  snippets        Json
  assessment      source_assessment
  explanation     String
  verification    reported_name_verifications @relation(fields: [verification_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([verification_id, source_id])
  @@index([verification_id])
  @@schema("public")
}

model User {
  id             String           @id
  name           String
  email          String           @unique
  emailVerified  Boolean          @default(false)
  image          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  firstName      String           @default("")
  lastName       String           @default("")
  role           roles            @default(user)
  accounts       Account[]
  sessions       Session[]
  report_reviews report_reviews[]
  reports        reports[]

  @@map("user")
  @@schema("better_auth")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("better_auth")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
  @@schema("better_auth")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("better_auth")
}

enum support_type {
  supported
  partial
  unsupported
  unknown
  likely

  @@schema("public")
}

enum report_status {
  pending
  under_review
  resolved
  rejected
  withdrawn

  @@schema("public")
}

enum source_type {
  observation
  website
  documentation
  hwinspect
  other

  @@schema("public")
}

enum source_assessment {
  supports
  contradicts
  insufficient

  @@schema("public")
}

enum roles {
  admin
  editor
  user

  @@schema("better_auth")
}
